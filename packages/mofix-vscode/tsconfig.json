{
    "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "lib": ["ES2020"],
      "outDir": "out",
      "strict": true,
      "sourceMap": true,
      "rootDir": "src",
      "esModuleInterop": true,
      "moduleResolution": "node",
      "types": ["node", "vscode"],
      "skipLibCheck": true
    },
    "include": ["src/**/*"]
  }
  